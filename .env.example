# ========================================================
# BeingCraft E-Commerce Payment & Security Configuration
# ========================================================

# Payment Mode: 'test' (Sandbox) | 'production' (Live Real Money) | 'mock' (Dev Only)
# CRITICAL: In production, mock payments are strictly forbidden and rejected with 403 Forbidden.
PAYMENT_MODE=test

# Razorpay API Credentials (Obtain from https://dashboard.razorpay.com/app/keys)
# For Test/Sandbox: starts with rzp_test_
# For Production: starts with rzp_live_
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (Configured in Razorpay Dashboard -> Settings -> Webhooks)
# Used to verify HMAC SHA-256 signature on incoming payment events (payment.captured, order.paid, payment.failed)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Client-facing Razorpay Key ID (Safe to expose to frontend for checkout modal initialization)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Standalone Server Port
PORT=3001
